# Copy to .env and fill in values. Never commit real secrets.

DATABASE_URL=
# Optional. Connections per ECS/Node process (default 5, max 20).
# Keep (tasks × DATABASE_POOL_MAX) below RDS max_connections.
# DATABASE_POOL_MAX=5
AUTH_SECRET=

# Initial Super Admin bootstrap (optional; run: npm run db:bootstrap-admin).
# Idempotent — no-ops if an active Super Admin already exists. Never assigned via SSO.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=

# Test line-manager accounts (optional; run: npm run db:seed:test-managers).
# Creates mgr1.test@zebl.local / mgr2.test@zebl.local as UserRole.employee with
# partitioned direct reports + User.recruitmentOpsAccess=true (permanent Recruitment ops).
# Runtime auth uses the DB flag — not email allowlists. Never commit real secrets.
# In production NODE_ENV, both ALLOW_TEST_MANAGER_SEED=true and a password are required.
# After changing recruitmentOpsAccess, users must re-login for the JWT claim to refresh.
# TEST_MANAGER_PASSWORD=
# ALLOW_TEST_MANAGER_SEED=false

# Public URL for emails/OAuth. Optional on Vercel — VERCEL_URL is used automatically.
APP_BASE_URL=http://localhost:3000

# Vercel production example (no custom domain):
# APP_BASE_URL=https://your-project.vercel.app

# SMTP (optional for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Cron/worker auth (required in production)
NOTIFICATION_CRON_SECRET=
INTEGRATION_CRON_SECRET=
ANALYTICS_CRON_SECRET=

# Approval email tokens (optional; falls back to AUTH_SECRET)
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_HOURS=72

# Microsoft Entra ID (OAuth 2.0 + PKCE)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# Opt-in only. Keep false in production unless you explicitly accept email→role linking risk.
AUTH_SSO_AUTO_LINK=false
AUTH_SSO_AUTO_PROVISION=false
AZURE_AD_GROUP_ROLE_MAP={}
AZURE_AD_APP_ROLE_MAP={}

# Microsoft Graph (calendar, org sync)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Teams incoming webhook
TEAMS_WEBHOOK_URL=
TEAMS_CALLBACK_SECRET=
CALENDAR_TIMEZONE=India Standard Time

# Attendance import — optional Phase 5 preview → confirm workflow.
# Default (unset/false): Upload → Import directly.
# Set to true to enable preview validation UI before writing.
ENABLE_ATTENDANCE_IMPORT_PREVIEW=false

# Recruitment module — default off until soft-launch.
# Set RECRUITMENT_MODULE_ENABLED=true to show /admin/recruitment shell + sidebar.
RECRUITMENT_MODULE_ENABLED=false
# Sub-flags (require module enabled). When unset, default ON if module is enabled.
# Set explicitly to false to disable offers or conversion independently.
# RECRUITMENT_OFFERS_ENABLED=true
# RECRUITMENT_CONVERSION_ENABLED=true

# Recruitment file storage. See docs/STORAGE.md for the full architecture.
# Driver: "local" (filesystem — dev AND current AWS EC2 deployment) or "s3"
# (future multi-instance scaling; not used for the initial EC2 deployment).
RECRUITMENT_STORAGE_DRIVER=local
# Local driver storage root — MUST point outside the app deploy directory in
# production so a code deploy never wipes uploaded files. Dev default shown;
# production example: RECRUITMENT_STORAGE_ROOT=/data/zebl/storage/recruitment
# RECRUITMENT_STORAGE_ROOT=./storage/recruitment
# S3 driver settings — not used while RECRUITMENT_STORAGE_DRIVER=local.
# RECRUITMENT_S3_BUCKET=
# RECRUITMENT_S3_REGION=ap-southeast-1
# RECRUITMENT_S3_PREFIX=recruitment
# RECRUITMENT_S3_ENDPOINT=
# RECRUITMENT_S3_FORCE_PATH_STYLE=false

# Recruitment AI enrichment (Gemini). Optional — resume import works without it.
# Also gated by RecruitmentSettings.aiEnabled (default true).
# Get a key from https://aistudio.google.com/apikey (AIza… or AQ.… — not OpenAI sk-…).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# Phase B selective semantic verification — DISABLED by default (deterministic A+ only).
# Set RESUME_SEMANTIC_VERIFY=1 only for experiments; production import must stay off.
# RESUME_SEMANTIC_VERIFY=0

# Resume parsing strategy (experimental).
# "deterministic" (default): Existing regex/heuristic parser (Phase A+).
# "llm": Send complete extracted text to Gemini for structured extraction.
# Requires GEMINI_API_KEY. Does not replace the deterministic parser — coexists
# as an alternative path for accuracy comparison.
# RESUME_PARSE_MODE=deterministic


# Primary DB: Supabase Postgres
# DATABASE_URL = Transaction pooler (port 6543) for the app / Vercel
# DIRECT_URL   = Direct DB (port 5432) for migrations — if 5432 is blocked locally,
#                temporarily set DIRECT_URL to the same pooler URL to run migrate deploy.
# Direct:   postgresql://postgres:[YOUR-PASSWORD]@db.ltkjnppndnkweatdzntz.supabase.co:5432/postgres
# Pooler:   postgresql://postgres.ltkjnppndnkweatdzntz:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Legacy Neon example (older deploys only):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
