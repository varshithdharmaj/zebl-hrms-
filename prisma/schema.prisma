model User {
  id                            String                        @id @default(cuid())
  email                         String                        @unique
  password                      String?
  role                          UserRole                      @default(employee)
  authProvider                  AuthProvider                  @default(local) @map("auth_provider")
  azureOid                      String?                       @unique @map("azure_oid")
  microsoftTenantId             String?                       @map("microsoft_tenant_id")
  lastLoginAt                   DateTime?                     @map("last_login_at")
  profilePhotoUrl               String?                       @map("profile_photo_url")
  profilePhotoStorageKey        String?                       @map("profile_photo_storage_key")
  authMetadata                  String                        @default("{}") @map("auth_metadata")
  sessionVersion                Int                           @default(1) @map("session_version")
  isActive                      Boolean                       @default(true) @map("is_active")
  username                      String?                       @unique
  accountStatus                 AccountStatus                 @default(active) @map("account_status")
  mustChangePassword            Boolean                       @default(false) @map("must_change_password")
  lockedAt                      DateTime?                     @map("locked_at")
  lockedReason                  String?                       @map("locked_reason")
  /**
   * Recruitment admin ops without HR role — permanent capability (not general /admin).
   */
  recruitmentOpsAccess          Boolean                       @default(false) @map("recruitment_ops_access")
  employeeId                    Int?                          @unique
  employee                      Employee?                     @relation(fields: [employeeId], references: [id])
  notificationPreference        NotificationPreference?
  assignedTickets               Ticket[]                      @relation("AssignedHandler")
  ticketMessages                TicketMessage[]
  ticketHistoryEntries          TicketHistory[]
  loginSessions                 LoginSession[]
  // Recruitment relations (Phase 0)
  pipelineTemplatesCreated      RecruitmentPipelineTemplate[] @relation("PipelineTemplateCreatedBy")
  jobOpeningsOwned              JobOpening[]                  @relation("JobOpeningOwner")
  jobOpeningsCreated            JobOpening[]                  @relation("JobOpeningCreatedBy")
  jobDocsUploaded               JobOpeningDocument[]          @relation("JobDocUploadedBy")
  jobNotesAuthored              JobOpeningNote[]              @relation("JobNoteAuthor")
  candidatesPrimary             Candidate[]                   @relation("CandidatePrimaryRecruiter")
  candidatesCreated             Candidate[]                   @relation("CandidateCreatedBy")
  candidateDocsUploaded         CandidateDocument[]           @relation("CandidateDocUploadedBy")
  candidateNotesAuthored        CandidateNote[]               @relation("CandidateNoteAuthor")
  candidateChatsAuthored        CandidateChatMessage[]        @relation("CandidateChatAuthor")
  intakeCreated                 IntakeItem[]                  @relation("IntakeCreatedBy")
  applicationsAsRecruiter       Application[]                 @relation("ApplicationRecruiter")
  applicationsCreated           Application[]                 @relation("ApplicationCreatedBy")
  applicationsAssessmentUpdated Application[]                 @relation("ApplicationAssessmentUpdatedBy")
  stageHistoryActed             ApplicationStageHistory[]     @relation("StageHistoryActor")
  interviewsCreated             Interview[]                   @relation("InterviewCreatedBy")
  decisionsAuthored             HiringDecision[]              @relation("DecisionAuthor")
  offersCreated                 Offer[]                       @relation("OfferCreatedBy")
  conversionsActed              EmployeeConversionSnapshot[]  @relation("ConversionActor")
  savedRecruitmentFilters       RecruitmentSavedFilter[]      @relation("RecruitmentSavedFilters")
  emailTemplatesCreated         RecruitmentEmailTemplate[]    @relation("EmailTemplateCreatedBy")
  communicationsSent            RecruitmentCommunication[]    @relation("CommunicationSender")
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt

  @@index([role])
  @@index([role, isActive])
  @@index([accountStatus])
  @@map("users")
}

model Employee {
  id                        Int                               @id @default(autoincrement())
  employeeCode              String                            @unique @map("employee_code")
  name                      String
  firstName                 String?                           @map("first_name")
  lastName                  String?                           @map("last_name")
  preferredName             String?                           @map("preferred_name")
  gender                    String?
  dateOfBirth               DateTime?                         @map("date_of_birth")
  email                     String?
  phone                     String?
  alternatePhone            String?                           @map("alternate_phone")
  address                   String?
  emergencyContact          String?                           @map("emergency_contact")
  department                String?
  designation               String?
  employmentType            String?                           @map("employment_type")
  workLocation              String?                           @map("work_location")
  shift                     String?
  joiningDate               DateTime                          @default(now()) @map("joining_date")
  employeeStatus            String                            @default("Active") @map("employee_status")
  isActive                  Boolean                           @default(true) @map("is_active")
  managerId                 Int?                              @map("manager_id")
  manager                   Employee?                         @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports             Employee[]                        @relation("EmployeeHierarchy")
  cachedPresence            String?                           @map("cached_presence")
  cachedPresenceAt          DateTime?                         @map("cached_presence_at")
  externalProfileSyncedAt   DateTime?                         @map("external_profile_synced_at")
  createdAt                 DateTime                          @default(now()) @map("created_at")
  updatedAt                 DateTime                          @updatedAt @map("updated_at")
  user                      User?
  attendanceRecords         AttendanceRecord[]
  regularizationRequests    AttendanceRegularizationRequest[]
  leaveRequests             LeaveRequest[]
  leaveBalance              EmployeeLeaveBalance?
  leaveTransactions         LeaveTransaction[]
  elAccrualLots             ElAccrualLot[]
  approvalSteps             LeaveApprovalStep[]
  payrollSummaries          PayrollAttendanceSummary[]
  raisedTickets             Ticket[]
  loginSessions             LoginSession[]
  // Recruitment relations (Phase 0)
  hiringTeamMemberships     HiringTeamMember[]
  headcountRequestedJobs    JobOpening[]                      @relation("JobHeadcountRequester")
  candidatesReferred        Candidate[]                       @relation("CandidateReferrer")
  convertedFromCandidate    Candidate?                        @relation("CandidateConvertedEmployee")
  applicationsAsManager     Application[]                     @relation("ApplicationManager")
  interviewPanelistOf       InterviewPanelist[]
  interviewFeedbackAuthored InterviewFeedback[]
  conversionSnapshots       EmployeeConversionSnapshot[]      @relation("ConversionSnapshotEmployee")
  // Biometric bridge integration (Phase 2D)
  biometricPunches          BiometricPunch[]

  @@index([managerId])
  @@index([employeeStatus])
  @@map("employees")
}

model AttendanceUpload {
  id          Int                @id @default(autoincrement())
  fileName    String             @map("file_name")
  uploadedBy  String?            @map("uploaded_by")
  recordCount Int                @default(0) @map("record_count")
  uploadedAt  DateTime           @default(now()) @map("uploaded_at")
  records     AttendanceRecord[]

  @@map("attendance_uploads")
}

/// Resumable attendance import: parse once, import in committed chunks, resume without re-upload.
model AttendanceImportJob {
  id                 String                    @id @default(cuid())
  createdByUserId    String                    @map("created_by_user_id")
  status             AttendanceImportJobStatus @default(UPLOADED)
  fileName           String                    @map("file_name")
  source             String
  reportType         String?                   @map("report_type")
  formAttendanceDate DateTime?                 @map("form_attendance_date")
  totalRows          Int                       @map("total_rows")
  nextRowIndex       Int                       @default(0) @map("next_row_index")
  importedCount      Int                       @default(0) @map("imported_count")
  skippedCount       Int                       @default(0) @map("skipped_count")
  employeesCreated   Int                       @default(0) @map("employees_created")
  usersCreated       Int                       @default(0) @map("users_created")
  warningsCount      Int                       @default(0) @map("warnings_count")
  errorCount         Int                       @default(0) @map("error_count")
  errorMessage       String?                   @map("error_message")
  payloadCompressed  Bytes                     @map("payload_compressed")
  parserVersion      String                    @map("parser_version")
  startedAt          DateTime?                 @map("started_at")
  completedAt        DateTime?                 @map("completed_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([createdByUserId, status, createdAt])
  @@map("attendance_import_jobs")
}

model AttendanceRecord {
  id              Int                 @id @default(autoincrement())
  employeeId      Int                 @map("employee_id")
  employee        Employee            @relation(fields: [employeeId], references: [id])
  uploadId        Int?                @map("upload_id")
  upload          AttendanceUpload?   @relation(fields: [uploadId], references: [id])
  attendanceDate  DateTime            @map("attendance_date")
  shift           String?
  checkIn         String?             @map("check_in")
  checkOut        String?             @map("check_out")
  workDuration    String?             @map("work_duration")
  workedMinutes   Int                 @default(0) @map("worked_minutes")
  overtimeMinutes Int                 @default(0) @map("overtime_minutes")
  status          String
  remarks         String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  sessions        AttendanceSession[]

  /// The currently-applied approved regularisation for this day, if any.
  /// Overlay provenance lives here rather than a denormalized "source" enum:
  /// activeRegularizationId != null IS the "this day has an HR correction" signal.
  activeRegularizationId Int?                             @unique @map("active_regularization_id")
  activeRegularization   AttendanceRegularizationRequest? @relation("ActiveRegularization", fields: [activeRegularizationId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_records")
}

/// Individual check-in / check-out period within a daily AttendanceRecord.
/// Daily totals (workedMinutes, status, legacy checkIn/checkOut) remain on AttendanceRecord.
model AttendanceSession {
  id            Int              @id @default(autoincrement())
  attendanceId  Int              @map("attendance_id")
  attendance    AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  checkIn       String           @map("check_in")
  checkOut      String?          @map("check_out")
  workedMinutes Int              @default(0) @map("worked_minutes")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([attendanceId])
  @@index([attendanceId, checkOut])
  @@map("attendance_sessions")
}

/// Employee-submitted, HR-reviewed correction to a day's derived attendance.
/// Never mutates BiometricPunch (raw device layer stays immutable); once
/// approved it is applied as an overlay on top of the punch-derived
/// AttendanceRecord/AttendanceSession rows by the same derivation pipeline
/// that builds them from raw punches (see deriveAttendanceForEmployeeDate).
model AttendanceRegularizationRequest {
  id             Int      @id @default(autoincrement())
  employeeId     Int      @map("employee_id")
  employee       Employee @relation(fields: [employeeId], references: [id])
  attendanceDate DateTime @map("attendance_date")

  requestType       RegularizationRequestType @map("request_type")
  requestedCheckIn  String?                   @map("requested_check_in")
  requestedCheckOut String?                   @map("requested_check_out")
  checkOutNextDay   Boolean                   @default(false) @map("check_out_next_day")
  reason            String

  status  RegularizationStatus @default(pending)
  version Int                  @default(0)

  submittedAt   DateTime  @default(now()) @map("submitted_at")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewComment String?   @map("review_comment")
  appliedAt     DateTime? @map("applied_at")
  cancelledAt   DateTime? @map("cancelled_at")

  /// Links a resubmission (after rejection) back to the request it replaces.
  previousRequestId Int?                             @unique @map("previous_request_id")
  previousRequest   AttendanceRegularizationRequest? @relation("Resubmission", fields: [previousRequestId], references: [id])
  resubmittedAs     AttendanceRegularizationRequest? @relation("Resubmission")

  /// Pre-correction AttendanceRecord snapshot (checkIn/checkOut/status/workedMinutes/remarks),
  /// captured at submission time for HR diff view and potential future revoke.
  snapshotBefore Json @default("{}") @map("snapshot_before")

  appliedRecord AttendanceRecord? @relation("ActiveRegularization")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employeeId, attendanceDate])
  @@index([status])
  @@index([employeeId, status])
  @@index([attendanceDate, status])
  @@map("attendance_regularization_requests")
}

model LeaveRequest {
  id                      Int                  @id @default(autoincrement())
  employeeId              Int                  @map("employee_id")
  employee                Employee             @relation(fields: [employeeId], references: [id])
  leaveType               String               @default("CL") @map("leave_type")
  startDate               DateTime             @map("start_date")
  endDate                 DateTime             @map("end_date")
  days                    Float                @default(0)
  reason                  String
  status                  LeaveRequestStatus   @default(pending)
  workflowStatus          LeaveWorkflowStatus  @default(pending_approval) @map("workflow_status")
  submittedAt             DateTime?            @map("submitted_at")
  currentStepId           Int?                 @unique @map("current_step_id")
  currentStep             LeaveApprovalStep?   @relation("CurrentApprovalStep", fields: [currentStepId], references: [id])
  rejectionReason         String?              @map("rejection_reason")
  cancelledAt             DateTime?            @map("cancelled_at")
  withdrawnAt             DateTime?            @map("withdrawn_at")
  finalApprovedAt         DateTime?            @map("final_approved_at")
  reviewedBy              String?              @map("reviewed_by")
  reviewedAt              DateTime?            @map("reviewed_at")
  version                 Int                  @default(0)
  externalCalendarEventId String?              @map("external_calendar_event_id")
  calendarSyncStatus      CalendarSyncStatus   @default(pending) @map("calendar_sync_status")
  calendarLastSyncedAt    DateTime?            @map("calendar_last_synced_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  approvalSteps           LeaveApprovalStep[]  @relation("LeaveApprovalSteps")
  approvalTokens          ApprovalToken[]
  workflowEscalations     WorkflowEscalation[]
  leaveConsumptions       LeaveConsumption[]

  @@index([employeeId, status])
  @@index([employeeId, workflowStatus])
  @@index([workflowStatus])
  @@map("leave_requests")
}

model LeaveApprovalStep {
  id              Int                @id @default(autoincrement())
  leaveRequestId  Int                @map("leave_request_id")
  leaveRequest    LeaveRequest       @relation("LeaveApprovalSteps", fields: [leaveRequestId], references: [id], onDelete: Cascade)
  currentForLeave LeaveRequest?      @relation("CurrentApprovalStep")
  stepOrder       Int                @map("step_order")
  approverId      Int?               @map("approver_id")
  approver        Employee?          @relation(fields: [approverId], references: [id], onDelete: SetNull)
  approverRole    ApproverRole       @map("approver_role")
  status          ApprovalStepStatus @default(pending)
  actedAt         DateTime?          @map("acted_at")
  actedByUserId   String?            @map("acted_by_user_id")
  comment         String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  approvalTokens  ApprovalToken[]

  @@unique([leaveRequestId, stepOrder])
  @@index([approverId, status])
  @@index([leaveRequestId])
  @@map("leave_approval_steps")
}

model ApprovalToken {
  id             String              @id @default(cuid())
  leaveRequestId Int                 @map("leave_request_id")
  leaveRequest   LeaveRequest        @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approvalStepId Int                 @map("approval_step_id")
  approvalStep   LeaveApprovalStep   @relation(fields: [approvalStepId], references: [id], onDelete: Cascade)
  approverId     Int?                @map("approver_id")
  approverUserId String?             @map("approver_user_id")
  action         ApprovalTokenAction
  tokenHash      String              @unique @map("token_hash")
  status         ApprovalTokenStatus @default(active)
  expiresAt      DateTime            @map("expires_at")
  usedAt         DateTime?           @map("used_at")
  revokedAt      DateTime?           @map("revoked_at")
  viewedAt       DateTime?           @map("viewed_at")
  createdBy      String?             @map("created_by")
  metadata       String              @default("{}")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([tokenHash])
  @@index([expiresAt])
  @@index([approverId])
  @@index([approvalStepId])
  @@index([leaveRequestId, approvalStepId])
  @@map("approval_tokens")
}

model EmployeeLeaveBalance {
  id         Int      @id @default(autoincrement())
  employeeId Int      @unique @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  elBalance  Float    @default(0) @map("el_balance")
  clBalance  Float    @default(0) @map("cl_balance")
  slBalance  Float    @default(0) @map("sl_balance")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("employee_leave_balances")
}

model LeaveTransaction {
  id              Int           @id @default(autoincrement())
  employeeId      Int           @map("employee_id")
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType       String        @map("leave_type")
  transactionType String        @map("transaction_type")
  amount          Float
  reason          String?
  createdBy       String?       @map("created_by")
  leaveRequestId  Int?          @map("leave_request_id")
  elAccrualLotId  Int?          @map("el_accrual_lot_id")
  elAccrualLot    ElAccrualLot? @relation(fields: [elAccrualLotId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([employeeId, leaveType])
  @@index([elAccrualLotId])
  /// Partial uniques (Postgres migration — Prisma has no partial-unique DSL):
  /// - (leave_request_id, transaction_type) WHERE leave_request_id IS NOT NULL
  ///   → at most one deduction and one cancel-restore accrual per leave request
  /// - (employee_id, reason) WHERE transaction_type = 'accrual' AND leave_request_id IS NULL AND reason IS NOT NULL
  ///   → idempotent system accruals (CL/SL yearly, EL monthly)
  @@map("leave_transactions")
}

/// Global, single-row (id fixed at 1) Leave Settings configuration for the
/// startup EL/SL policy. Policy changes here never rewrite already-created
/// ElAccrualLot rows (their accrualDate/expiryDate are computed and stored
/// at accrual time) — so changing e.g. elExpiryMonths only affects future accruals.
model LeavePolicySettings {
  id                  Int      @id @default(1)
  cycleStartDay       Int      @default(26) @map("cycle_start_day")
  elAccrualAmount     Float    @default(0.5) @map("el_accrual_amount")
  elEligibilityMonths Int      @default(14) @map("el_eligibility_months")
  elExpiryMonths      Int      @default(36) @map("el_expiry_months")
  slAnnualEntitlement Int      @default(6) @map("sl_annual_entitlement")
  slCarryForward      Boolean  @default(false) @map("sl_carry_forward")
  slExpiryMonths      Int?     @map("sl_expiry_months")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedBy           String?  @map("updated_by")

  @@map("leave_policy_settings")
}

/// One row per Earned Leave accrual event ("lot"), enabling FIFO consumption
/// and per-lot 36-month expiry. cycleKey (e.g. "2027-03") is the accrual-job
/// idempotency key — running the accrual job twice for the same employee/month
/// hits the unique constraint on the second attempt.
model ElAccrualLot {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleKey    String   @map("cycle_key")
  accrualDate DateTime @map("accrual_date")
  amount      Float
  remaining   Float
  expiryDate  DateTime @map("expiry_date")
  createdAt   DateTime @default(now()) @map("created_at")

  transactions LeaveTransaction[]
  consumptions LeaveConsumption[]

  @@unique([employeeId, cycleKey])
  @@index([employeeId, expiryDate])
  @@index([employeeId, accrualDate])
  @@map("el_accrual_lots")
}

/// Records exactly which EL lot(s) a given LeaveRequest's approval consumed,
/// and how much of each — required so cancellation/reversal can restore the
/// precise amount to the precise lot (not a flat balance bump).
model LeaveConsumption {
  id             Int          @id @default(autoincrement())
  leaveRequestId Int          @map("leave_request_id")
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  elAccrualLotId Int          @map("el_accrual_lot_id")
  elAccrualLot   ElAccrualLot @relation(fields: [elAccrualLotId], references: [id])
  amount         Float
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([leaveRequestId])
  @@index([elAccrualLotId])
  @@map("leave_consumptions")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  name        String
  holidayDate DateTime @unique @map("holiday_date")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

model Notification {
  id            String                     @id @default(cuid())
  type          NotificationType
  channel       NotificationChannel
  recipient     String
  subject       String
  payload       String                     @default("{}")
  status        NotificationDeliveryStatus @default(pending)
  attempts      Int                        @default(0)
  lastError     String?                    @map("last_error")
  correlationId String?                    @map("correlation_id")
  scheduledAt   DateTime                   @default(now()) @map("scheduled_at")
  sentAt        DateTime?                  @map("sent_at")
  lockedAt      DateTime?                  @map("locked_at")
  lockedBy      String?                    @map("locked_by")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@index([status, lockedAt])
  @@index([recipient])
