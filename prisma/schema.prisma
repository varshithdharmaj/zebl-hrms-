// Cloudflare Workers config (uncomment for Cloudflare deploy):
// generator client {
//   provider   = "prisma-client"
//   output     = "../src/generated/prisma"
//   runtime    = "cloudflare"
//   engineType = "client"
// }

// Local Node.js / Vercel (Next.js) config:
generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  engineType    = "library"
  // Vercel serverless runtime needs the RHEL engine; native covers local Windows/macOS/Linux.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

